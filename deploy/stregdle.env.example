# Copy to /data/stregdle/stregdle.env, then chmod 600 and chown stregdle:stregdle.
# systemd reads this file through EnvironmentFile= in deploy/stregdle.service.

# Required: a real secret, and the host name people will use.
STREGDLE_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
STREGDLE_ALLOWED_HOSTS=stregdle.fklub.dk

# Served over HTTPS behind the reverse proxy (enables redirect, HSTS, secure cookies).
STREGDLE_HTTPS=1

# Where the header's Menu/Genstart buttons go, and the footer's source link.
STREGSYSTEM_URL=https://streg.fklub.dk/
STREGDLE_SOURCE_URL=https://github.com/f-klubben/stregdle

# Read-only access to the shop's database.
STREG_DB_HOST=127.0.0.1
STREG_DB_PORT=3306
STREG_DB_NAME=stregsystem
STREG_DB_USER=stregdle
STREG_DB_PASSWORD=replace-with-the-password-from-the-grant

# One JSON file per day of guesses, counted by the statistics page at /statistics/.
# Must be listed in ReadWritePaths= of stregdle.service; empty switches it off.
STREGDLE_STATS_DIR=/data/stregdle/var
